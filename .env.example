# API Football (API-Sports - inscription directe, PAS RapidAPI)
# Inscription: https://dashboard.api-football.com/register
# Cle API: Account -> My Access dans le dashboard
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_AUTH=apisports
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# PostgreSQL
POSTGRES_USER=prono
POSTGRES_PASSWORD=prono_secret
POSTGRES_DB=prono
DATABASE_URL=postgres://prono:prono_secret@localhost:5432/prono?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# Backend Go
JWT_SECRET=change_me_in_production
BACKEND_PORT=8082
BACKEND_URL=http://localhost:8082
ML_SERVICE_URL=http://localhost:5002
AI_AGENT_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Service
ML_CONFIDENCE_THRESHOLD=0.55
ML_MODELS_DIR=./models

# AI Agent (Mistral)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_BASE=https://api.mistral.ai/v1
LLM_MODEL=ministral-14b-2512
AI_CONFIDENCE_THRESHOLD=0.55

# Collector
COLLECTOR_SYNC_INTERVAL=6h
COLLECTOR_LIVE_INTERVAL=60s
COLLECTOR_BACKFILL_START_YEAR=2018
COLLECTOR_LIVE_SCOPE=all
COLLECTOR_LIVE_MAX=20

# Frontend (dev Vite / Docker nginx sur :5173)
VITE_API_URL=/api/v1
